# Copy to .env and fill in. .env is gitignored.

# Required for embedding (ingest) and generation (agent).
GEMINI_API_KEY=your-key-here

# Optional overrides (defaults shown). Prefer the "-latest" alias — pinned
# versions (e.g. gemini-2.5-flash) get retired and 404 for new users.
# CODEJUDGE_AI_GEN_MODEL=gemini-flash-latest
# CODEJUDGE_AI_EMBED_MODEL=gemini-embedding-001

# --- Agent -> MCP: where the agent finds the MCP server (Streamable HTTP). ---
# CODEJUDGE_MCP_URL=http://localhost:8081/mcp

# --- MCP server (codejudge_mcp) settings. ---
# CODEJUDGE_BASE_URL=http://localhost:8080   # the running CodeJudge API it fronts
# MCP_HOST=127.0.0.1
# MCP_PORT=8081
# MCP_PATH=/mcp                              # keep in sync with CODEJUDGE_MCP_URL above

# Where CodeJudge's docs live, for the sync script (READ-ONLY source).
# CODEJUDGE_DOCS_DIR=../CodeJudge/docs

# RAG tuning.
# CODEJUDGE_AI_CHUNK_SIZE=1200
# CODEJUDGE_AI_CHUNK_OVERLAP=200
# CODEJUDGE_AI_TOP_K=4
# CODEJUDGE_AI_MIN_SCORE=0.6      # drop retrieved chunks below this cosine score

# Agent behavior.
# CODEJUDGE_AI_GUARDRAIL=1        # input guardrail (screens user messages); 0 to disable
# CODEJUDGE_AI_TRACE=0            # 1 = verbose logs + console OpenTelemetry spans in the chat REPL
